#!/bin/sh
set -e
if [ -z "${APPDIR:-}" ]; then
    APPDIR="$(cd "$(dirname "$0")/../.." && pwd)"
    export APPDIR
fi
PYTHON="${PYTHON:-python3}"
if ! command -v "$PYTHON" >/dev/null 2>&1; then
    if command -v zenity >/dev/null 2>&1; then
        zenity --error --title "Custom Robo" \
            --text "Python 3 is required to run this launcher."
    fi
    exit 1
fi
if ! "$PYTHON" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)'; then
    if command -v zenity >/dev/null 2>&1; then
        zenity --error --title "Custom Robo" \
            --text "Python 3.10 or newer is required (found $("$PYTHON" -V 2>&1))."
    fi
    exit 1
fi
exec "$PYTHON" "$APPDIR/usr/share/custom-robo/launcher/linux_ui.py" "$@"
